    \{label:'Gross profit',     key:'gp',  bold:true\},\
    \{label:'Operating profit', key:'op',  bold:true\},\
    \{label:'Profit after tax', key:'pat', bold:true\},\
  ];\
  rows.forEach(r=>\{\
    tHtml += `<tr$\{r.bold?' class="total"':''\}><td class="$\{r.bold?'bold':''\}">$\{r.label\}</td>$\{scenarios.map(s=>`<td style="font-weight:600;color:$\{s[r.key]>=0?'#175E54':'#AA272F'\}">$\{fmt(s[r.key])\}</td>`).join('')\}</tr>`;\
  \});\
  tHtml += '</tbody>';\
  document.getElementById('scenario-table').innerHTML = tHtml;\
\
  document.getElementById('scenario-narrative').innerHTML = `\
    <div class="callout red"><strong>Conservative:</strong> No rate increase. Utilisation 10% below target. Revenue \'a31.09m. Profit after tax drops to \'a371k \'97 a significant step backward from 2025/26. Avoid this scenario by implementing fee rates and tracking utilisation from April.</div>\
    <div class="callout gold"><strong>Base plan:</strong> 8% fee rate increase from April. Utilisation hitting targets. Revenue \'a31.35m. PAT \'a3192k. Viable and above \'a31.3m target \'97 but below the \'a3300k profit ambition.</div>\
    <div class="callout green"><strong>Stretch:</strong> Rate increase + target utilisation + vacant Arboricultural Consultant post filled by Q2. Revenue \'a31.48m. PAT \'a3247k. Closest route to the \'a3300\'96350k profit target.</div>\
    <div class="callout sky" style="margin-top:8px"><strong>Your model:</strong> Current settings project \'a3$\{Math.round(tv/1000)\}k turnover and \'a3$\{Math.round(pat/1000)\}k profit after tax. $\{tv>=1300000?'\uc0\u10003  Above the \'a31.3m revenue target.':'Adjust utilisation, headcount or rate multiplier to reach the \'a31.3m target.'\}</div>`;\
\}\
\
function updateBreakdownPage()\{\
  const rMult = parseInt(document.getElementById('g-rate').value)/100;\
  let tableHtml = `<thead><tr>\
    <th>Grade</th><th>People</th><th>Base rate</th><th>Effective rate</th>\
    <th>Utilisation</th><th>Hrs/person/yr</th><th>Total hrs</th>\
    <th>Revenue</th><th>% of fee total</th>\
  </tr></thead><tbody>`;\
\
  const feeRev = totalFeeRevenue();\
  let grandTotalHrs = 0;\
\
  GRADES.forEach(g=>\{\
    const effectiveRate = (g.baseRate * rMult).toFixed(2);\
    const util = state[g.id].util;\
    const people = state[g.id].people;\
    const rev = gradeRevenue(g);\
\
    // Calculate avg available hrs per person for this grade\
    const teamMembers = TEAM.filter(t => t.grade === g.id);\
    let totalChargeableHrs = 0;\
    let hrsPerPerson = BASE_AVAIL;\
\
    if(teamMembers.length > 0)\{\
      let sumAvail = 0;\
      const count = Math.min(people, teamMembers.length);\
      for(let i=0; i<count; i++)\{\
        const avail = Math.round(BASE_AVAIL * (teamMembers[i].hrs / FULL_HRS));\
        sumAvail += avail;\
        totalChargeableHrs += Math.round(avail * util);\
      \}\
      // Any extra people beyond known team = full time\
      for(let i=teamMembers.length; i<people; i++)\{\
        sumAvail += BASE_AVAIL;\
        totalChargeableHrs += Math.round(BASE_AVAIL * util);\
      \}\
      hrsPerPerson = people > 0 ? Math.round(sumAvail / people) : BASE_AVAIL;\
    \} else \{\
      totalChargeableHrs = Math.round(BASE_AVAIL * util * people);\
      hrsPerPerson = BASE_AVAIL;\
    \}\
\
    grandTotalHrs += totalChargeableHrs;\
    const share = feeRev > 0 ? ((rev/feeRev)*100).toFixed(1)+'%' : '\'97';\
    const ragC = col(util, g.targetUtil);\
\
    tableHtml += `<tr>\
      <td><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:$\{g.color\};margin-right:6px;vertical-align:middle"></span>\
          <span class="bold">$\{g.label\}</span></td>\
      <td>$\{people\}</td>\
      <td style="color:var(--muted)">\'a3$\{g.baseRate\}/hr</td>\
      <td style="font-weight:700;color:var(--night-sky)">\'a3$\{effectiveRate\}/hr</td>\
      <td style="font-weight:700;color:$\{ragC\}">$\{Math.round(util*100)\}%</td>\
      <td>$\{hrsPerPerson.toLocaleString()\}</td>\
      <td>$\{totalChargeableHrs.toLocaleString()\}</td>\
      <td style="font-weight:800;color:#175E54">$\{fmt(rev)\}</td>\
      <td style="font-weight:700;color:var(--sky)">$\{share\}</td>\
    </tr>`;\
  \});\
\
  const tv = feeRev + OTHER_INCOME;\
  tableHtml += `<tr class="total">\
    <td colspan="6">Total fee revenue</td>\
    <td>$\{grandTotalHrs.toLocaleString()\}</td>\
    <td style="color:#175E54">$\{fmt(feeRev)\}</td>\
    <td>100%</td>\
  </tr>`;\
  tableHtml += '</tbody>';\
  document.getElementById('breakdown-table').innerHTML = tableHtml;\
\
  // Waterfall\
  const cos = Math.round(tv * COS_RATE);\
  const gp = tv - cos;\
  const admin = ADMIN_FIXED;\
  const op = gp - admin;\
  const tax = op>0 ? Math.round(op*TAX) : 0;\
  const pat = op - tax;\
  const wfData = [\
    \{label:'Turnover',    val:tv,    color:'#21314D'\},\
    \{label:'Cost of sales', val:-cos,color:'#AA272F'\},\
    \{label:'Gross profit',  val:gp,  color:'#175E54'\},\
    \{label:'Admin',         val:-admin,color:'#AA272F'\},\
    \{label:'Op. profit',    val:op,  color:op>0?'#175E54':'#AA272F'\},\
    \{label:'Tax',           val:-tax,color:'#5C7F92'\},\
    \{label:'PAT',           val:pat, color:pat>0?'#EAAB00':'#AA272F'\},\
  ];\
  const maxAbs = Math.max(...wfData.map(d=>Math.abs(d.val)));\
  const wfH = 160;\
  document.getElementById('waterfall').innerHTML = wfData.map(d=>\{\
    const h = Math.max(4,Math.round((Math.abs(d.val)/maxAbs)*wfH));\
    return `<div class="wf-col">\
      <div class="wf-value">$\{d.val<0?'-':''\}\'a3$\{Math.round(Math.abs(d.val)/1000)\}k</div>\
      <div class="wf-bar" style="height:$\{h\}px;background:$\{d.color\}"></div>\
    </div>`;\
  \}).join('');\
  document.getElementById('waterfall-labels').innerHTML = wfData.map(d=>`\
    <div style="flex:1;text-align:center;font-size:8px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.3px">$\{d.label\}</div>`).join('');\
\}\
