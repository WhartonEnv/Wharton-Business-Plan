// State\
let state = \{\};\
GRADES.forEach(g=>\{\
  state[g.id] = \{util: g.targetUtil, people: g.defaultPeople\};\
  if(g.id==='senior') state[g.id] = \{util:0.75, people:3\};\
  if(g.id==='cons')   state[g.id] = \{util:0.80, people:4\};\
  if(g.id==='director') state[g.id] = \{util:0.30, people:1\};\
  if(g.id==='ops')      state[g.id] = \{util:0.35, people:1\};\
  if(g.id==='roots')    state[g.id] = \{util:0.35, people:1\};\
\});\
\
function fmt(n)\{return'\'a3'+Math.round(n).toLocaleString('en-GB')\}\
function pct(n)\{return(n>=0?'+':'')+n.toFixed(1)+'%'\}\
function col(v,t)\{return v>=t*0.99?'#175E54':v>=t*0.85?'#EAAB00':'#AA272F'\}\
\
function availHrs(grade, hoursPerWeek)\{\
  const ratio = hoursPerWeek / FULL_HRS;\
  return Math.round(BASE_AVAIL * ratio);\
\}\
\
function gradeRevenue(g)\{\
  const rMult = parseInt(document.getElementById('g-rate').value)/100;\
  const rate = g.baseRate * rMult;\
  const util = state[g.id].util;\
  const people = state[g.id].people;\
\
  // Use actual contracted hours per person from TEAM array\
  const teamMembers = TEAM.filter(t => t.grade === g.id);\
  let totalHrs = 0;\
  if(teamMembers.length > 0 && people <= teamMembers.length)\{\
    // Use actual hours for known team members\
    for(let i=0; i<people; i++)\{\
      const hrs = teamMembers[i] ? teamMembers[i].hrs : FULL_HRS;\
      const avail = Math.round(BASE_AVAIL * (hrs / FULL_HRS));\
      totalHrs += Math.round(avail * util);\
    \}\
  \} else \{\
    // Fallback: assume full-time for any extra headcount\
    totalHrs = Math.round(BASE_AVAIL * util * people);\
  \}\
  return Math.round(totalHrs * rate);\
\}\
\
function totalFeeRevenue()\{\
  return GRADES.reduce((s,g)=>s+gradeRevenue(g),0);\
\}\
\
function calc()\{\
  const rMult = parseInt(document.getElementById('g-rate').value)/100;\
  const rPct = Math.round((rMult-1)*100);\
  document.getElementById('g-rate-v').textContent = (rPct>=0?'+':'')+rPct+'%';\
\
  const feeRev = totalFeeRevenue();\
  const tv = feeRev + OTHER_INCOME;\
  const cos = tv * COS_RATE;\
  const gp = tv - cos;\
  const gm = (gp/tv)*100;\
  const op = gp - ADMIN_FIXED;\
  const pat = op>0 ? op*(1-TAX) : op;\
  const tvGap = tv - 1300000;\
  const totalPeople = GRADES.reduce((s,g)=>s+state[g.id].people,0);\
  const totalHrs = GRADES.reduce((s,g)=>s+Math.round(BASE_AVAIL*state[g.id].util*state[g.id].people),0);\
\
  document.getElementById('m-tv').textContent = fmt(tv);\
  document.getElementById('m-tv-s').textContent = (tvGap>=0?'+':'')+fmt(Math.abs(tvGap))+(tvGap>=0?' ahead':' short');\
  document.getElementById('m-tv-s').className = 'ms '+(tvGap>=0?'up':'dn');\
  document.getElementById('m-fee').textContent = fmt(feeRev);\
  document.getElementById('m-gp').textContent = fmt(gp);\
  document.getElementById('m-gm').textContent = 'Margin: '+gm.toFixed(1)+'%';\
  document.getElementById('m-gm').className = 'ms '+(gm>=45?'up':gm>=38?'warn':'dn');\
  document.getElementById('m-gap').textContent = fmt(Math.abs(tvGap));\
  document.getElementById('m-gap-s').textContent = tvGap>=0?'Above target':'Below target';\
  document.getElementById('m-gap-s').className = 'ms '+(tvGap>=0?'up':'dn');\
  document.getElementById('m-hrs').textContent = totalHrs.toLocaleString();\
  document.getElementById('m-rph').textContent = fmt(feeRev/Math.max(1,totalPeople));\
\
  // Target bars\
  const bars = [\
    \{label:'Turnover (target \'a31.3m)', val:tv, target:1300000\},\
    \{label:'Gross profit (target \'a3560k)', val:gp, target:560000\},\
    \{label:'Operating profit (target \'a3256k)', val:op, target:256000\},\
  ];\
  document.getElementById('target-bars').innerHTML = bars.map(b=>\{\
    const p = Math.min(100,(b.val/b.target)*100);\
    const c = col(b.val,b.target);\
    return `<div class="tgt-row">\
      <div class="tgt-label">$\{b.label\}</div>\
      <div class="tgt-track"><div class="tgt-fill" style="width:$\{p\}%;background:$\{c\}"></div></div>\
      <div class="tgt-pct" style="color:$\{c\}">$\{fmt(b.val)\} \'97 $\{p.toFixed(0)\}%</div>\
    </div>`;\
  \}).join('');\
\
  // Update grade slider displays\
  GRADES.forEach(g=>\{\
    const rev = gradeRevenue(g);\
    const el = document.getElementById('gb-rev-'+g.id);\
    if(el) el.textContent = fmt(rev);\
    const hoursEl = document.getElementById('sl-hrs-'+g.id);\
    if(hoursEl)\{\
      const hrs = Math.round(BASE_AVAIL * state[g.id].util * state[g.id].people);\
      hoursEl.textContent = hrs.toLocaleString()+' hrs/yr';\
    \}\
    const monthEl = document.getElementById('sl-mhrs-'+g.id);\
    if(monthEl)\{\
      const mhrs = Math.round(BASE_AVAIL * state[g.id].util * state[g.id].people / 12);\
      monthEl.textContent = Math.round(mhrs)+' hrs/month avg';\
    \}\
  \});\
\
  updateUtilPage();\
  updateMonthlyPage();\
  updateScenariosPage(feeRev, tv, gp, op, pat);\
  updateBreakdownPage();\
\}\
\
function buildSliders()\{\
  const cont = document.getElementById('grade-sliders');\
  cont.innerHTML = '';\
  GRADES.forEach(g=>\{\
    const hdr = `background:$\{g.color\}`;\
    const div = document.createElement('div');\
    div.className = 'grade-block';\
    div.innerHTML = `\
      <div class="gb-header" style="$\{hdr\}">\
        <div class="gb-title">$\{g.label\}</div>\
        <div class="gb-rev" id="gb-rev-$\{g.id\}">\'a30</div>\
      </div>\
      <div class="gb-body">\
        <div class="people-row">\
          <div class="sl-label">People</div>\
          <div class="people-btns">\
            <div class="pb" onclick="changePeople('$\{g.id\}',-1)">\uc0\u8722 </div>\
            <div class="people-count" id="pc-$\{g.id\}">$\{state[g.id].people\}</div>\
            <div class="pb" onclick="changePeople('$\{g.id\}',1)">+</div>\
          </div>\
        </div>\
        <div class="sl-row">\
          <div class="sl-label">Utilisation</div>\
          <div class="sl-track">\
            <input type="range" id="util-$\{g.id\}" min="30" max="100" value="$\{Math.round(g.targetUtil*100)\}" step="1"\
              style="accent-color:$\{g.color\}" oninput="onUtil('$\{g.id\}')">\
          </div>\
          <div class="sl-val" id="uv-$\{g.id\}">$\{Math.round(g.targetUtil*100)\}%</div>\
        </div>\
        <div class="sl-hours" id="sl-hrs-$\{g.id\}">0 hrs/yr</div>\
        <div class="sl-hours" id="sl-mhrs-$\{g.id\}" style="margin-top:-8px">0 hrs/month avg</div>\
        <div class="sl-row">\
          <div class="sl-label" style="font-size:9px">Target util</div>\
          <div style="font-size:10px;font-weight:700;color:$\{g.color\}">$\{Math.round(g.targetUtil*100)\}%</div>\
          <div style="flex:1"></div>\
          <div class="sl-val" style="font-size:10px;color:var(--muted)">Rate: \'a3$\{g.baseRate\}/hr</div>\
        </div>\
      </div>`;\
    cont.appendChild(div);\
  \});\
\}\
\
function onUtil(id)\{\
  const v = parseInt(document.getElementById('util-'+id).value);\
  state[id].util = v/100;\
  document.getElementById('uv-'+id).textContent = v+'%';\
  calc();\
\}\
\
function changePeople(id, delta)\{\
  const g = GRADES.find(x=>x.id===id);\
  const newVal = Math.max(0,Math.min(g.maxPeople, state[id].people+delta));\
  state[id].people = newVal;\
  document.getElementById('pc-'+id).textContent = newVal;\
  calc();\
\}\
\
function updateUtilPage()\{\
  // Individual util rows\
  let html = '';\
  TEAM.forEach(p=>\{\
    const g = GRADES.find(x=>x.id===p.grade);\
    if(!g) return;\
    const avail = availHrs(p.grade, p.hrs);\
    const tgt = g.targetUtil;\
    const actual = state[g.id].util;\
    const chargeable = Math.round(avail * actual);\
    const tgtChargeable = Math.round(avail * tgt);\
    const pct = Math.round(actual*100);\
    const c = col(actual, tgt);\
    const pctWidth = Math.min(100, actual*100);\
    html += `<div class="util-row">\
      <div class="util-name">$\{p.name\}</div>\
      <div class="util-grade">$\{g.label\}</div>\
      <div class="util-track"><div class="util-fill" style="width:$\{pctWidth\}%;background:$\{c\}"></div></div>\
      <div class="util-pct" style="color:$\{c\}">$\{pct\}%</div>\
      <div class="util-hrs">$\{chargeable.toLocaleString()\} hrs/yr</div>\
    </div>`;\
  \});\
  document.getElementById('util-table').innerHTML = html;\
\
  // RAG grid\
  let ragHtml = '';\
  GRADES.forEach(g=>\{\
    const actual = state[g.id].util;\
    const tgt = g.targetUtil;\
    const rag = actual>=tgt*0.99?'g':actual>=tgt*0.85?'a':'r';\
    const ragLabel = rag==='g'?'On target':rag==='a'?'Watch':'Below target';\
    const c = rag==='g'?'#175E54':rag==='a'?'#EAAB00':'#AA272F';\
    ragHtml += `<div class="card" style="padding:12px 14px;border-top:3px solid $\{g.color\}">\
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">\
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--text)">$\{g.label\}</div>\
        <div class="rag $\{rag\}"></div>\
      </div>\
      <div style="font-size:20px;font-weight:800;color:$\{g.color\}">$\{Math.round(actual*100)\}%</div>\
      <div style="font-size:9px;font-weight:700;color:$\{c\};margin-top:3px;text-transform:uppercase;letter-spacing:.5px">$\{ragLabel\}</div>\
      <div style="font-size:9px;color:var(--muted);margin-top:2px">Target: $\{Math.round(tgt*100)\}% &nbsp;\'b7&nbsp; $\{state[g.id].people\} people</div>\
    </div>`;\
  \});\
  document.getElementById('util-rag-grid').innerHTML = ragHtml;\
\}\
\
function updateMonthlyPage()\{\
  const rMult = parseInt(document.getElementById('g-rate').value)/100;\
  const totalAnnualHrs = GRADES.reduce((s,g)=>s+Math.round(BASE_AVAIL*state[g.id].util*state[g.id].people),0);\
  const totalAnnualRev = totalFeeRevenue() + OTHER_INCOME;\
  const monthTab = document.getElementById('active-month-tab')?.value||'hours';\
\
  // Monthly hours\
  const mHrs = SEASON.map(s=>Math.round(totalAnnualHrs * s / SEASON.reduce((a,b)=>a+b,0)));\
  const mRev = SEASON.map((s,i)=>Math.round(totalAnnualRev * s / SEASON.reduce((a,b)=>a+b,0)));\
  const mTargets = [310000,310000,310000,350000,350000,350000,320000,320000,320000,320000,320000,320000].map(v=>v/3);\
\
  const maxHrs = Math.max(...mHrs);\
  const maxRev = Math.max(...mRev,100000);\
\
  // Chart\
  const data = currentMonthTab==='revenue' ? mRev : mHrs;\
  const maxData = currentMonthTab==='revenue' ? maxRev : maxHrs;\
  const barColor = currentMonthTab==='revenue' ? '#175E54' : '#21314D';\
  const prefix = currentMonthTab==='revenue' ? '\'a3' : '';\
\
  document.getElementById('month-chart').innerHTML = MONTHS.map((m,i)=>\{\
    const h = Math.round((data[i]/maxData)*80);\
    let dispVal = currentMonthTab==='revenue' ? '\'a3'+Math.round(data[i]/1000)+'k' : data[i].toLocaleString();\
    return `<div class="month-col">\
      <div class="month-val">$\{dispVal\}</div>\
      <div class="month-bar-wrap"><div class="month-bar" style="height:$\{h\}px;background:$\{barColor\}"></div></div>\
      <div class="month-label">$\{m\}</div>\
    </div>`;\
  \}).join('');\
\
  // Monthly table\
  const qMap = [0,0,0,1,1,1,2,2,2,3,3,3];\
  const qNames = ['Q1','Q2','Q3','Q4'];\
  const qTgts = [310000,350000,320000,320000];\
  let tableHtml = `<thead><tr><th>Month</th><th>Quarter</th><th>Chargeable hrs</th><th>Revenue (est.)</th><th>Q target</th><th>Cumulative</th><th>vs annual target</th></tr></thead><tbody>`;\
  let cumRev = 0;\
  mRev.forEach((rev,i)=>\{\
    cumRev += rev;\
    const q = qMap[i];\
    const annualPct = Math.min(100,(cumRev/1300000)*100).toFixed(0);\
    const c = col(cumRev, 1300000*(i+1)/12);\
    tableHtml += `<tr>\
      <td class="bold">$\{MONTHS[i]\}</td>\
      <td>$\{qNames[q]\}</td>\
      <td>$\{mHrs[i].toLocaleString()\}</td>\
      <td style="font-weight:700">\'a3$\{Math.round(rev/1000)\}k</td>\
      <td style="color:var(--muted)">\'a3$\{Math.round(qTgts[q]/1000)\}k</td>\
      <td style="font-weight:700;color:$\{c\}">\'a3$\{Math.round(cumRev/1000)\}k</td>\
      <td style="font-weight:700;color:$\{c\}">$\{annualPct\}%</td>\
    </tr>`;\
  \});\
  tableHtml += `<tr class="total"><td colspan="2">Full year</td><td>$\{totalAnnualHrs.toLocaleString()\}</td><td>\'a3$\{Math.round(totalAnnualRev/1000)\}k</td><td>\'a31,300k</td><td style="color:$\{col(totalAnnualRev,1300000)\}">\'a3$\{Math.round(cumRev/1000)\}k</td><td style="color:$\{col(totalAnnualRev,1300000)\}">$\{((totalAnnualRev/1300000)*100).toFixed(0)\}%</td></tr>`;\
  tableHtml += '</tbody>';\
  document.getElementById('monthly-table').innerHTML = tableHtml;\
\}\
\
function updateScenariosPage(feeRev, tv, gp, op, pat)\{\
  const scenarios = [\
    \{label:'Conservative',  sub:'No rate increase, -10% utilisation', tv:1090000, gp:465000, op:95000, pat:71155, color:'#AA272F'\},\
    \{label:'Base plan',     sub:'+8% rates, target utilisation',       tv:1346000, gp:666000, op:256000, pat:191744, color:'#EAAB00'\},\
    \{label:'Stretch',       sub:'+8% rates + vacant post filled',      tv:1480000, gp:750000, op:330000, pat:247170, color:'#175E54'\},\
    \{label:'Your model',    sub:'Current slider settings',             tv, gp, op, pat, color:'#21314D'\},\
  ];\
\
  document.getElementById('scenario-metrics').innerHTML = scenarios.map(s=>\{\
    const onTarget = s.tv >= 1300000;\
    return `<div class="metric" style="border-top:3px solid $\{s.color\}">\
      <div class="ml">$\{s.label\}</div>\
      <div class="mv" style="font-size:14px;color:$\{s.color\}">$\{fmt(s.tv)\}</div>\
