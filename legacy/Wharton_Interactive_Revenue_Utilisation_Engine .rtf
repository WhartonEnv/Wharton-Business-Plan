function showPage(id, el)\{\
  document.querySelectorAll('.pg').forEach(p=>p.classList.remove('active'));\
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));\
  document.getElementById('pg-'+id).classList.add('active');\
  if(el) el.classList.add('active');\
  const titles = \{revenue:'Revenue Engine',utilisation:'Utilisation Tracker',monthly:'Monthly Hours & Revenue',scenarios:'Scenario Planner',breakdown:'Grade Breakdown'\};\
  const subs = \{revenue:'Adjust multipliers to model fee-earning scenarios',utilisation:'Individual and grade-level utilisation analysis',monthly:'Seasonal distribution of hours and revenue',scenarios:'Compare conservative, base, stretch and custom scenarios',breakdown:'Revenue contribution by grade \'97 waterfall view'\};\
  document.getElementById('page-title').textContent = titles[id]||id;\
  document.getElementById('page-sub').textContent = subs[id]||'';\
  if(id==='monthly') updateMonthlyPage();\
\}\
